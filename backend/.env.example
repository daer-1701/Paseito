# Copiar a .env y completar
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Se usa si el principal está saturado o tarda más de GEMINI_TIMEOUT_S
GEMINI_MODEL_RESPALDO=gemini-3.8-flash
GEMINI_TIMEOUT_S=25
# low | medium | high (gemini-3.8-flash no acepta minimal; vacío = valor por defecto del modelo)
GEMINI_THINKING=low

# Voz del avatar. edge = voces neuronales de Microsoft (rápidas, sin cuota) | gemini = Gemini TTS (lento)
TTS_MOTOR=edge
EDGE_TTS_VOZ=es-BO-SofiaNeural
# Velocidad de edge, p. ej. +10% o -5%
EDGE_TTS_VELOCIDAD=+0%
# Solo con TTS_MOTOR=gemini: modelos en orden de preferencia, separados por coma
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
GEMINI_TTS_VOZ=Kore
GEMINI_TTS_TIMEOUT_S=40

# Orígenes permitidos para el frontend, separados por coma
CORS_ORIGINS=*
# Carpeta del frontend que se sirve en "/" (por defecto ../frontend). Vacío = solo API
# FRONTEND_DIR=

# Si se define, las rutas /admin exigen el header X-Admin-Token
ADMIN_TOKEN=

# Paseo Points (fidelización): base MySQL del sistema de puntos, solo lectura. Vacío = sin integración.
# Formato: mysql://usuario:clave@host:puerto/base
PUNTOS_DATABASE_URL=
# Certificado CA del servidor MySQL (ruta relativa a backend/), p. ej. ../ca.pem
PUNTOS_DB_CA=
PUNTOS_TIMEOUT_S=6
# API de Paseo Points (sin / final) y su clave de integración (INTEGRATION_API_KEY de ellos).
# Con ambas, el QR de cliente se valida en POST /api/integrations/customer-qr/verify.
PUNTOS_API_URL=
PUNTOS_API_KEY=
# Respaldo sin API: secreto dedicado al QR de cliente. Nunca el JWT_SECRET de sesiones de Paseo Points.
PUNTOS_QR_SECRET=
