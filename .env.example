# Generated automatically by scripts/start-tower.sh. Never commit .env.
JARVIS_INGEST_TOKEN=
JARVIS_PUBLIC_PORT=8000
# Set only after confirming the physical kiosk position with the Paseo.
JARVIS_KIOSK_ORIGIN=Punto del kiosco pendiente de configurar
# Public/LAN URL reachable from phones; leave empty until deployment is configured.
JARVIS_MOBILE_BASE_URL=
# Optional compose.mobile.yaml public-facts gateway; set a confirmed LAN IP for Wi-Fi access.
JARVIS_MOBILE_BIND=127.0.0.1
JARVIS_MOBILE_PORT=8080
# Synthetic catalogue: only for demonstration; prices are estimates, never official offers.
JARVIS_DEMO_CATALOG=0
# Inbound Twilio adapter. Leave disabled until credentials and HTTPS are configured.
JARVIS_WHATSAPP_PROVIDER=disabled
JARVIS_WHATSAPP_WEBHOOK_URL=
JARVIS_WHATSAPP_SESSION_SECRET=
TWILIO_AUTH_TOKEN=
# Loopback-only webhook gateway, for a later dedicated HTTPS tunnel.
JARVIS_WHATSAPP_PORT=8081
# Start with multilingual small; compare large-v3-turbo on the actual GPU.
WHISPER_MODEL=small
KOKORO_VOICE=ef_dora
# Set to 1 only after the selected models/voice have downloaded and warmed up.
HF_HUB_OFFLINE=0
